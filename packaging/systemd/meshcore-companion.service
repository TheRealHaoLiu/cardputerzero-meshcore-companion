[Unit]
Description=MeshCore Companion (MeshCore node on the Cap LoRa-1262; Bluetooth and TCP companion)
Documentation=https://github.com/TheRealHaoLiu/cardputerzero-meshcore-companion
Requires=meshcore-companion.socket
After=meshcore-companion.socket bluetooth.service network.target
# A service that keeps crashing stops after 5 starts in 5 minutes instead of looping
# (each start loads the radio library and writes to the journal on the SD card).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Radio access (spi, gpio, i2c, dialout) and BlueZ come from group membership (postinst).
User=meshcore
Group=meshcore
StateDirectory=meshcore-companion
StateDirectoryMode=0750
# The node identity and everything else the service writes is for its user only.
UMask=0077
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/lib/meshcore-companion/meshcore-companiond
# With "Run in background" off the service exits 0 when idle; the socket starts it again.
# With it on, a failed radio or Bluetooth start is retried inside the service.
Restart=on-failure
RestartSec=10
# A burst of log lines (a library in a loop) must not fill the 50 MB journal on the SD card.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
# Under memory pressure the kernel kills the radio node before the launcher.
OOMScoreAdjust=200
# A memory cap belongs here too, but the right value must be measured on the device
# (peak RSS of a running node with Bluetooth and a full contact list, plus headroom):
#MemoryHigh=
#MemoryMax=
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
