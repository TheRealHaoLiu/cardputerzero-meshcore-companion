[Unit]
Description=MeshCore Companion control socket (starts the service on demand)

[Socket]
ListenStream=/run/meshcore-companion/control.sock
# Whoever can read the keyboard may use the tile. The tile reads the keys from
# /dev/input, so the user who runs it is in group input already; other local users and
# services (not in that group) cannot switch Wi-Fi on, open the pairing window or
# forget phones. The service gets the socket from systemd and needs no group.
SocketMode=0660
SocketGroup=input
DirectoryMode=0755

[Install]
WantedBy=sockets.target
