#!/bin/sh
set -e
UNITS="meshcore-companion.socket meshcore-companion.service"
MARK=/run/meshcore-companion.upgrade-restart  # prerm: the service ran before the upgrade
if [ "$1" = "configure" ]; then
    if ! getent passwd meshcore >/dev/null; then
        adduser --system --group --no-create-home --home /var/lib/meshcore-companion \
            meshcore >/dev/null
    fi
    # Radio (SPI, GPIO, the Cap's I2C expander, the GPS serial port) and BlueZ access by
    # group membership, not by running as root.
    for grp in spi gpio i2c dialout bluetooth; do
        if getent group "$grp" >/dev/null; then
            adduser meshcore "$grp" >/dev/null 2>&1 || true
        fi
    done
    # Bytecode, once, here: the service user cannot write the install directory, so
    # without it every start would compile the whole library again. prerm removes it.
    python3 -m compileall -q -j 0 /usr/lib/meshcore-companion >/dev/null || true

    # Enable on first install only; an administrator's disable survives upgrades.
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        for unit in $UNITS; do
            deb-systemd-helper unmask "$unit" >/dev/null || true
            if deb-systemd-helper --quiet was-enabled "$unit"; then
                deb-systemd-helper enable "$unit" >/dev/null || true
            else
                deb-systemd-helper update-state "$unit" >/dev/null || true
            fi
        done
    elif [ -z "$2" ] && [ -d /run/systemd/system ]; then
        systemctl enable $UNITS >/dev/null 2>&1 || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        if [ -z "$2" ]; then
            systemctl start $UNITS || true
        else
            # An upgrade: a new socket unit takes effect only when the socket restarts
            # (the service is stopped now), and the service starts again only if it ran.
            systemctl try-restart meshcore-companion.socket || true
            if [ -e "$MARK" ]; then
                systemctl start meshcore-companion.service || true
            elif dpkg --compare-versions "$2" le-nl "0.1.0-1" \
                    && systemctl is-enabled --quiet meshcore-companion.service; then
                # 0.1.0-1's prerm stopped the service without leaving the mark: start it
                # if it is enabled (with background off it exits again when idle).
                systemctl start meshcore-companion.service || true
            fi
        fi
    fi
    rm -f "$MARK"
fi
exit 0
