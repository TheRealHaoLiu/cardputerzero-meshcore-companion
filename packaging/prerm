#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then
    systemctl stop meshcore-companion.service meshcore-companion.socket >/dev/null 2>&1 || true
    if [ "$1" = "remove" ]; then
        systemctl disable meshcore-companion.service meshcore-companion.socket >/dev/null 2>&1 || true
    fi
fi
exit 0
